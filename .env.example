# Server-side only. Never prefix these with NEXT_PUBLIC_.
ASTERRA_API_BASE_URL=https://YOUR-BACKEND-HOST      # the /api/v1 prefix is added by the client
ASTERRA_API_KEY=                                    # optional; sent as Bearer token if your backend requires auth
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5                   # optional
ASSISTANT_BACKEND_TIMEOUT_MS=8000                   # optional
ASSISTANT_LLM_TIMEOUT_MS=45000                      # optional
ASSISTANT_MAX_TOOL_ROUNDS=4                         # optional
