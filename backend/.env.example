# Copy to .env and adjust. Never commit .env.
ASTERRA_ENVIRONMENT=dev
ASTERRA_CORS_ORIGINS=["http://localhost:3000"]

ASTERRA_CACHE_DIR=.cache
ASTERRA_CACHE_TTL_SECONDS=86400
ASTERRA_HTTP_TIMEOUT_SECONDS=60

# --- Optional providers (leave empty until you wire them up) ---
# NASA Earthdata (SMAP, GPM IMERG): https://urs.earthdata.nasa.gov/
ASTERRA_EARTHDATA_TOKEN=
# Google Earth Engine (Sentinel-2 / MODIS NDVI, SRTM)
ASTERRA_GEE_PROJECT=
ASTERRA_GEE_SERVICE_ACCOUNT=
ASTERRA_GEE_KEY_FILE=
# Optional LLM explanations
ASTERRA_ANTHROPIC_API_KEY=
