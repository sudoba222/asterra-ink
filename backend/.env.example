# Copy to .env and fill in. Never commit .env.
ASTERRA_ENVIRONMENT=dev
ASTERRA_CORS_ORIGINS=["http://localhost:3000"]

ASTERRA_CACHE_DIR=.cache
ASTERRA_CACHE_TTL_SECONDS=86400

# Copernicus Data Space Ecosystem OAuth client (secret: server only, never in the frontend).
# https://shapps.dataspace.copernicus.eu/dashboard/ → User settings → OAuth clients → Create
ASTERRA_COPERNICUS_CLIENT_ID=
ASTERRA_COPERNICUS_CLIENT_SECRET=

# NASA Earthdata Login token (https://urs.earthdata.nasa.gov → Generate Token). Expires every 60 days.
ASTERRA_EARTHDATA_TOKEN=

# Limits that protect the free Copernicus quota
ASTERRA_MAX_FIELD_HECTARES=5000
ASTERRA_MAX_RANGE_DAYS=1098
